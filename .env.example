# Copy to .env and fill in locally.  NEVER commit .env  (it is in .gitignore).
#
# Phase 1 Task 1 (checkpoint loading + generation) needs NONE of these.
# They are placeholders for later tasks only.

# --- Course Gemini judge (Task 4). Not used yet. ---
# Each student receives a personal key; the team shares a $250 budget across
# Gemini + TPU.  Do not commit, share, or print these values.
COURSE_API_KEY=
COURSE_API_BASE_URL=
COURSE_JUDGE_MODEL=

# --- Hugging Face (optional) ---
# Only needed for private/gated repos or to raise rate limits.
# The TinyStories checkpoints are public and ungated, so this is NOT required.
HF_TOKEN=

# --- Optional: redirect the Hugging Face cache off the default ~/.cache ---
# HF_HOME=
